{
    "name": "frostealth/kronika",
    "description": "DateTime value objects such as Date, Time, LocalDateTime, etc.",
    "license": "MIT",
    "type": "library",
    "keywords": ["datetime", "date", "time", "value-object", "value-objects", "vo"],
    "homepage": "https://github.com/frostealth/kronika",
    "authors": [
        {
            "name": "Ivan Kudinov",
            "email": "i@ikudinov.pro"
        }
    ],
    "require": {
        "php": "^8.4"
    },
    "require-dev": {
        "ext-bcmath": "*",
        "ext-gmp": "*",
        "doctrine/dbal": "^4.3",
        "jms/serializer": "^3.32",
        "laravel/framework": "^11.0 | ^12.0",
        "phpunit/phpunit": "^12.4",
        "psr/clock": "^1.0",
        "symfony/serializer": "^7.3",
        "vimeo/psalm": "^6.13",
        "yiisoft/yii2": "^2.0.53"
    },
    "autoload": {
        "psr-4": {
            "Kronika\\": "src/Kronika/",
            "Kronika\\Extension\\": "src/Extension/",
            "Kronika\\Utils\\": "src/Utils/"
        },
        "files": [
            "src/Kronika/functions.php",
            "src/Utils/functions.php",
            "src/Utils/Math/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Kronika\\Tests\\": "tests/Kronika",
            "Kronika\\Extension\\Tests\\": "tests/Extension",
            "Kronika\\Utils\\Tests\\": "tests/Utils"
        }
    },
    "provide": {
        "psr/clock-implementation": "1.0"
    },
    "extra": {
        "branch-alias": {
            "dev-0.x": "0.2-dev",
            "dev-0.1": "0.1-dev"
        },
        "laravel": {
            "providers": [
                "Kronika\\Extension\\Laravel\\Clock\\ClockServiceProvider"
            ],
            "aliases": {
                "Kronika": "Kronika\\Extension\\Laravel\\Clock\\Facade"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "yiisoft/yii2-composer": false
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "psalm": "./vendor/bin/psalm",
        "phpunit-kronika": "./vendor/bin/phpunit --testsuite 'Kronika\\Utils','Kronika'",
        "phpunit-extension": "./vendor/bin/phpunit --testsuite 'Kronika\\Extension'",
        "test": ["@psalm", "@phpunit-kronika", "@phpunit-extension"]
    }
}
